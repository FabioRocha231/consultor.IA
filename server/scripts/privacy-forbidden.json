    "api2.amplitude.com",
    "sentry.io",
    "*.sentry.io",
    "datadoghq.com",
    "*.datadoghq.com",
    "newrelic.com",
    "*.newrelic.com",
    "plausible.io",
    "google-analytics.com",
    "www.google-analytics.com",
    "googletagmanager.com",
    "facebook.net",
    "connect.facebook.net",
    "hotjar.com",
    "*.hotjar.com",
    "fullstory.com",
    "*.fullstory.com",
    "logrocket.com",
    "*.logrocket.com",
    "intercom.io",
    "*.intercom.io",
    "crisp.chat",
    "*.crisp.chat"
  ],
  "npm_packages": [
    "posthog-node",
    "posthog-js",
    "posthog-react",
    "mixpanel",
    "mixpanel-browser",
    "segment",
    "@segment/*",
    "amplitude",
    "@amplitude/*",
    "@sentry/*",
    "@sentry/node",
    "@sentry/browser",
    "@sentry/react",
    "dd-trace",
    "@datadog/*",
    "newrelic",
    "@newrelic/*",
    "@plausible/*",
    "react-ga",
    "react-ga4",
    "react-facebook-pixel",
    "react-hotjar",
    "@logrocket/*",
    "@intercom/*"
  ],
  "env_var_patterns": [
    "^POSTHOG_",
    "^MIXPANEL_",
    "^SEGMENT_",
    "^AMPLITUDE_",
    "^SENTRY_DSN",
    "^SENTRY_",
    "^DD_API",
    "^DD_",
    "^NEWRELIC_",
    "^GA_",
    "^GTAG_",
    "^HOTJAR_"
  ],
  "headers": [
    "Authorization",
    "X-Api-Key",
    "Cookie",
    "Set-Cookie"
  ]
}
